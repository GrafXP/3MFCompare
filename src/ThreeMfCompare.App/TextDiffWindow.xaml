<Window x:Class="ThreeMfCompare.App.TextDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeMfCompare.App"
        Title="{Binding Title}" Width="1100" Height="780" MinWidth="600" MinHeight="400"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="Only changes, with 3 lines around them" IsChecked="{Binding OnlyChanges}" VerticalAlignment="Center"
                          Visibility="{Binding IsDiff, Converter={StaticResource BoolVisible}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" FontSize="16" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Lines}" Margin="8" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DiffRow}">
                    <Grid x:Name="Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Old}" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" Margin="0,1,8,1" />
                        <TextBlock Grid.Column="1" Text="{Binding New}" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" Margin="0,1,8,1" />
                        <TextBlock Grid.Column="2" x:Name="Mark" Text="{Binding Mark}" Margin="0,1" />
                        <TextBlock Grid.Column="3" x:Name="Text" Text="{Binding Text}" Margin="0,1,12,1" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource GoodBackBrush}" />
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource GoodBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerBackBrush}" />
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Gap">
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
