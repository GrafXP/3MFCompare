<Window x:Class="ThreeMfCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeMfCompare.App"
        Title="{Binding Title}" Width="1600" Height="980" MinWidth="1000" MinHeight="640"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="StepArrow" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- The cells of a row: one per file, all of a width. -->
        <ItemsPanelTemplate x:Key="Columns">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <!-- A file at the head of a column: its colour, its name and whether it is the baseline. -->
        <DataTemplate x:Key="ColumnHeader" DataType="{x:Type local:ProjectViewModel}">
            <Border Margin="2,0" Padding="9,7" CornerRadius="6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="10" Height="10" Fill="{Binding IdentityBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    </DockPanel>
                    <TextBlock x:Name="Role" Text="compared with the baseline" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="18,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBaseline}" Value="True">
                    <Setter TargetName="Role" Property="Text" Value="baseline" />
                    <Setter TargetName="Role" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One line of a value: what it belongs to (a filament with its colour, an extruder), then the value. -->
        <DataTemplate x:Key="CellLineTemplate" DataType="{x:Type local:CellLine}">
            <DockPanel Margin="0,1">
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Swatch}" Margin="0,0,6,0" VerticalAlignment="Center"
                         Stroke="#40FFFFFF" StrokeThickness="0.5" Visibility="{Binding Swatch, Converter={StaticResource Shown}}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"
                           Visibility="{Binding Label, Converter={StaticResource Shown}}" />
                <TextBlock x:Name="Value" Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A file's value of a setting: amber where it is not the baseline's; the pen marks a value changed from the system preset. -->
        <DataTemplate x:Key="SettingCellTemplate" DataType="{x:Type local:SettingCellViewModel}">
            <Border x:Name="Root" Margin="2,1" Padding="9,5" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                    ToolTip="{Binding Tip}" ToolTipService.ShowDuration="60000">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource CautionBrush}" Margin="6,2,0,0" VerticalAlignment="Top"
                               Visibility="{Binding IsCustomized, Converter={StaticResource BoolVisible}}" />
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource CellLineTemplate}" />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding LongTextAction}" Margin="-8,2,0,0" Padding="8,2" FontSize="12"
                                Command="{Binding DataContext.ShowTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsLongText, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Differs}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource CautionBackBrush}" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A setting across the files. -->
        <DataTemplate DataType="{x:Type local:SettingRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,6,10,6" VerticalAlignment="Top">
                    <TextBlock x:Name="Label" Text="{Binding Label}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding KeyText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding KeyText, Converter={StaticResource Shown}}" ToolTip="{Binding KeyText}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource SettingCellTemplate}" ItemsPanel="{StaticResource Columns}" Margin="0,1" />
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{StaticResource DividerBrush}" Opacity="0.6" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKey}" Value="True">
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CategoryHeader}">
            <StackPanel Orientation="Horizontal" Margin="12,20,12,6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                <TextBlock Text="{Binding Counts}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,1" VerticalAlignment="Bottom" FontSize="12" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:MetricHeader}">
            <StackPanel Orientation="Horizontal" Margin="12,18,12,6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="10,0,0,1" VerticalAlignment="Bottom" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- A slice result across the files, with a bar in the file's colour where values add up to something. -->
        <DataTemplate DataType="{x:Type local:MetricRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Margin="12,7,10,7" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource Columns}" Margin="0,1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MetricCell}">
                            <Border x:Name="Root" Margin="2,1" Padding="9,5" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Delta}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Value" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <Border x:Name="Bar" Height="4" CornerRadius="2" Margin="0,5,0,1" Background="{Binding Bar}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Differs}" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource CautionBackBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasBar}" Value="False">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{StaticResource DividerBrush}" Opacity="0.6" />
            </Grid>
        </DataTemplate>

        <!-- A label and a value on a project's card. -->
        <DataTemplate x:Key="FactRow" DataType="{x:Type local:Fact}">
            <DockPanel Margin="0,3" ToolTip="{Binding Tip}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" Width="86" />
                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="FilamentRow" DataType="{x:Type local:FilamentItem}">
            <DockPanel Margin="0,3">
                <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Fill="{Binding Swatch}" Stroke="#40FFFFFF" StrokeThickness="0.5" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,8,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Preset}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preset}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The window's own background is not part of its content, which a screenshot is of. -->
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== The top bar: the app, the pages, the files and the slicer ===== -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,24,0" VerticalAlignment="Center">
                    <!-- Two prints side by side. -->
                    <Canvas Width="24" Height="22" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="0" Canvas.Top="4" Width="10" Height="16" RadiusX="2" RadiusY="2" Fill="#FF3987E5" />
                        <Rectangle Canvas.Left="13" Canvas.Top="0" Width="10" Height="20" RadiusX="2" RadiusY="2" Fill="#FFE8803A" />
                    </Canvas>
                    <TextBlock Text="3MF Compare" Style="{StaticResource PageTitle}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Step}" Tag="1" Content="Files" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Files}" />
                    <TextBlock Style="{StaticResource StepArrow}" />
                    <RadioButton Style="{StaticResource Step}" Tag="2" Content="Settings" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Settings}" />
                    <TextBlock Style="{StaticResource StepArrow}" />
                    <RadioButton Style="{StaticResource Step}" Tag="3" Content="Slice results" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Slices}" />
                    <TextBlock Style="{StaticResource StepArrow}" />
                    <RadioButton Style="{StaticResource Step}" Tag="4" Content="G-code" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Gcode}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SliceProgress}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <Button Content="Cancel" local:Look.Icon="&#xE711;" Command="{Binding CancelSlicingCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsSlicing, Converter={StaticResource BoolVisible}}" />
                    <Button Content="Open…" local:Look.Icon="&#xE8E5;" Click="Open_Click" Margin="0,0,8,0" ToolTip="Add Bambu Studio projects (Ctrl+O); or drop them on the window" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Slice all" local:Look.Icon="&#xE768;" Command="{Binding SliceAllCommand}" ToolTip="{Binding BambuText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 1 Files ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Files}">
            <StackPanel Margin="24,20,24,12">
                <!-- Nothing open yet. -->
                <Grid Width="660" Margin="0,70,0,0" HorizontalAlignment="Center" Visibility="{Binding HasProjects, Converter={StaticResource Shown}, ConverterParameter=Not}">
                    <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource ControlBorderBrush}" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{StaticResource PanelBrush}" />
                    <StackPanel Margin="48,44" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="38" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Drop Bambu Studio projects here" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="500" FontSize="13" LineHeight="19"
                                   Text="Two or more .3mf projects, typically of one model with different print settings. Each is held against the first, the baseline: its settings, Bambu Studio's estimates when sliced, and the G-code layer by layer." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Open projects…" Click="Open_Click" HorizontalAlignment="Center" Margin="0,20,0,0" local:Look.Icon="&#xE8E5;" />
                    </StackPanel>
                </Grid>

                <!-- The key settings that differ. -->
                <Border Style="{StaticResource Card}" Visibility="{Binding DifferenceSummary, Converter={StaticResource Shown}}" Margin="0,0,14,16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="All differences" local:Look.Icon="&#xE76C;"
                                    Command="{Binding ShowSettingsOfCommand}" CommandParameter="All settings" Margin="0,-6,-8,0" />
                            <TextBlock Text="At a glance" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                        </DockPanel>
                        <TextBlock Text="{Binding DifferenceSummary}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,4" Visibility="{Binding KeyDifferences.Count, Converter={StaticResource Shown}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ColumnHeader}" ItemsPanel="{StaticResource Columns}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding KeyDifferences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:KeyDifference}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Margin="0,6,10,6" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource SettingCellTemplate}" ItemsPanel="{StaticResource Columns}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- A card per project. -->
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProjectViewModel}">
                            <Border Style="{StaticResource Card}" Width="350" Margin="0,0,14,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-6,-8,0">
                                            <Button Style="{StaticResource IconButton}" local:Look.Icon="&#xE76B;" ToolTip="Move left"
                                                    Command="{Binding DataContext.MoveLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" local:Look.Icon="&#xE76C;" ToolTip="Move right"
                                                    Command="{Binding DataContext.MoveRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" local:Look.Icon="&#xE711;" ToolTip="Close this project"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <Ellipse Width="11" Height="11" Fill="{Binding IdentityBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="9,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath}" />
                                    </DockPanel>

                                    <Grid Margin="0,6,0,0" Height="24">
                                        <Border x:Name="BaselineChip" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource PrimaryBrush}" CornerRadius="9" Padding="9,2" Visibility="Collapsed">
                                            <TextBlock Text="Baseline" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Button x:Name="MakeBaseline" Style="{StaticResource LinkButton}" Content="Use as baseline" local:Look.Icon="&#xE734;" Margin="-8,0,0,0" Padding="8,2" FontSize="12"
                                                Command="{Binding DataContext.SetBaselineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Grid>

                                    <Border Background="{StaticResource ViewportBrush}" CornerRadius="8" Height="230" Margin="0,8,0,12">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <DockPanel Margin="0,0,0,8" Visibility="{Binding ModelVerdict, Converter={StaticResource Shown}}">
                                        <TextBlock x:Name="VerdictIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock x:Name="Verdict" Text="{Binding ModelVerdict}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" />
                                    <TextBlock Text="Filaments" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                                    <ItemsControl ItemsSource="{Binding Filaments}" ItemTemplate="{StaticResource FilamentRow}" />

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,10" />
                                    <DockPanel>
                                        <Button x:Name="SliceButton" DockPanel.Dock="Right" Content="Slice" local:Look.Icon="&#xE768;" Margin="8,-2,0,-2" Padding="10,4"
                                                Command="{Binding DataContext.SliceProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <TextBlock x:Name="SliceIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE81E;" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock x:Name="SliceText" Text="{Binding SliceText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBaseline}" Value="True">
                                    <Setter TargetName="BaselineChip" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="MakeBaseline" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="VerdictIcon" Property="Text" Value="&#xE735;" />
                                    <Setter TargetName="VerdictIcon" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter TargetName="Verdict" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModelMatch}" Value="Different">
                                    <Setter TargetName="VerdictIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="VerdictIcon" Property="Foreground" Value="{StaticResource CautionBrush}" />
                                    <Setter TargetName="Verdict" Property="Foreground" Value="{StaticResource CautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSliced}" Value="True">
                                    <Setter TargetName="SliceButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SliceIcon" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="SliceIcon" Property="Foreground" Value="{StaticResource GoodBrush}" />
                                    <Setter TargetName="SliceText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SliceState}" Value="Slicing">
                                    <Setter TargetName="SliceButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SliceIcon" Property="Text" Value="&#xE895;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SliceState}" Value="Queued">
                                    <Setter TargetName="SliceButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SliceState}" Value="Failed">
                                    <Setter TargetName="SliceIcon" Property="Text" Value="&#xE783;" />
                                    <Setter TargetName="SliceIcon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter TargetName="SliceText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 2 Settings ===== -->
        <Grid Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Settings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,16,14,14">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,6,8,6" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" FontSize="12" />
                            <TextBlock Text="Search settings and values" Foreground="{StaticResource TextMutedBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Search, Converter={StaticResource Shown}, ConverterParameter=Not}" />
                        </Grid>
                        <CheckBox Content="Only differences" IsChecked="{Binding OnlyDifferences}" Margin="2,14,0,0" />
                        <CheckBox Content="Only changed from presets" IsChecked="{Binding OnlyCustomized}" Margin="2,7,0,0"
                                  ToolTip="Settings that a file changed from the system preset it is based on; such values carry a pen." />
                        <CheckBox Content="Hide bookkeeping" IsChecked="{Binding HideBookkeeping}" Margin="2,7,0,0"
                                  ToolTip="Lists that only name things and differ between any two saves: nozzle variant names, compatible printers, the version, the list of changed settings." />
                        <TextBlock Text="Groups" Style="{StaticResource FieldLabel}" Margin="2,20,0,6" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,12,0,0"
                               Text="Amber: not the baseline's value. Pen: changed from the system preset. Settings with one entry per nozzle variant show the variant in use, per filament where they belong to filaments; hover a value for all of them." />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="0,0,0,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CategoryFilter}">
                                <DockPanel>
                                    <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="8" Padding="7,0" MinWidth="22" Background="{StaticResource CautionBackBrush}" BorderBrush="{StaticResource CautionBorderBrush}" BorderThickness="1"
                                            ToolTip="Settings of this group that differ from the baseline">
                                        <TextBlock Text="{Binding Differences}" Foreground="{StaticResource CautionBrush}" FontSize="11.5" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Differences}" Value="0">
                                        <Setter TargetName="Badge" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- The heads of the columns; the right margin leaves room for the scroll bar below. -->
                <Grid Margin="12,14,30,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock Text="{Binding SelectedCategory.Name}" Style="{StaticResource PageTitle}" FontSize="16" />
                        <TextBlock Text="{Binding SettingsSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ColumnHeader}" ItemsPanel="{StaticResource Columns}" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding SettingItems}" Margin="12,0,4,0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,16" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Style="{StaticResource Body}"
                           Text="Nothing to show: no setting here differs from the baseline, or none matches the search."
                           Visibility="{Binding SettingItems.Count, Converter={StaticResource Shown}, ConverterParameter=Not}" />
            </Grid>
        </Grid>

        <!-- ===== 3 Slice results ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Slices}">
            <StackPanel Margin="24,16,24,24">
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasPlates, Converter={StaticResource BoolVisible}}">
                        <TextBlock Text="Plate" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding PlateNumbers}" SelectedItem="{Binding SelectedPlate}" Width="80" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Slice results" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Every project sliced by Bambu Studio's command line exactly as it was saved: its printer, process, filaments, plates, object settings and variable layer heights." />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Visibility="{Binding SlicedCount, Converter={StaticResource Shown}, ConverterParameter=Not}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Slice all" local:Look.Icon="&#xE768;" Command="{Binding SliceAllCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Nothing is sliced yet" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding BambuText}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8,10,8,12" Visibility="{Binding SlicedCount, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ColumnHeader}" ItemsPanel="{StaticResource Columns}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MetricItems}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding LayerChart.Count, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProjectViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                            <Rectangle Width="16" Height="3" Fill="{Binding IdentityBrush}" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5" />
                                            <TextBlock Text="{Binding ShortName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Layer time by height" Style="{StaticResource CardTitle}" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="{Binding MetricsNote}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <local:LayerTimeChart Series="{Binding LayerChart}" Height="340" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 4 G-code ===== -->
        <Grid Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Gcode}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Panes}" Margin="8,8,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.PaneColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ToolpathPaneViewModel}">
                        <local:ToolpathPane Margin="4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ToolpathNote, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding ToolpathNote}" Style="{StaticResource Body}" TextAlignment="Center" MaxWidth="460" />
                <Button Style="{StaticResource PrimaryButton}" Content="Slice all" local:Look.Icon="&#xE768;" Command="{Binding SliceAllCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding Panes.Count, Converter={StaticResource Shown}, ConverterParameter=Not}" />
            </StackPanel>

            <local:LayerSlider Grid.Column="1" Margin="0,14,4,14" Maximum="{Binding LevelCount}" Lower="{Binding LowerLevel}" Upper="{Binding UpperLevel}" Labels="{Binding LevelLabels}"
                               ToolTip="Height in mm. Wheel or arrow keys: top handle; with Shift the bottom one; with Ctrl both." />

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <StackPanel Visibility="{Binding HasPlates, Converter={StaticResource BoolVisible}}" Margin="0,0,0,10">
                            <TextBlock Text="Plate" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding PlateNumbers}" SelectedItem="{Binding SelectedPlate}" />
                        </StackPanel>

                        <TextBlock Text="Colour by" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Colourings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Colouring}" />

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Scale, Converter={StaticResource Shown}}">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                <Run Text="{Binding Scale.Title, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Scale.Unit, Mode=OneWay}" />
                            </TextBlock>
                            <Border Height="12" CornerRadius="3" Background="{Binding ScaleBrush}" Margin="0,6,0,4" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleMax}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding ScaleMin}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="One scale for every pane, so a colour is the same value in all of them. Grey: not part of the model." />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Colouring, Converter={StaticResource IsVisible}, ConverterParameter=Filament}">
                            <TextBlock Text="Filaments" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding FilamentLegend}" ItemTemplate="{StaticResource FilamentRow}" />
                        </StackPanel>

                        <TextBlock Text="Line types" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding LegendItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LegendItem}">
                                    <CheckBox IsChecked="{Binding IsShown}" Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="View" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <WrapPanel>
                            <Button Style="{StaticResource ViewButton}" Content="Iso" Command="{Binding ViewFromCommand}" CommandParameter="iso" />
                            <Button Style="{StaticResource ViewButton}" Content="Top" Command="{Binding ViewFromCommand}" CommandParameter="top" />
                            <Button Style="{StaticResource ViewButton}" Content="Front" Command="{Binding ViewFromCommand}" CommandParameter="front" />
                            <Button Style="{StaticResource ViewButton}" Content="Left" Command="{Binding ViewFromCommand}" CommandParameter="left" />
                            <Button Style="{StaticResource ViewButton}" Content="Fit" Command="{Binding ViewFromCommand}" CommandParameter="fit" />
                        </WrapPanel>
                        <Button Content="Single layer ⇄ all below" Command="{Binding SingleLayerCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="12" Padding="10,5"
                                ToolTip="Only the layer at the top handle, or everything below it again" />
                        <CheckBox Content="Beads (each line's width and height)" IsChecked="{Binding UseBeads}" Margin="0,14,0,0" />
                        <CheckBox Content="Turn all panes together" IsChecked="{Binding SyncCameras}" Margin="0,7,0,0" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                                   Text="Left drag turns, right or middle drag pans, the wheel zooms, a double click frames the prints. The slider steps by height: each pane shows the layer it prints at that height, so prints of different layer heights stay level." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Status ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding BambuText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
